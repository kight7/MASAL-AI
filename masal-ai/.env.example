# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (server only)
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# Suggested: gemini-3.6-flash (verify on Google AI Studio)
GEMINI_MODEL=
# Suggested: openai/gpt-oss-120b (verify on the Groq console)
GROQ_MODEL=

# Optional
# "true" skips Gemini and uses Groq only (demos and fallback tests)
FORCE_FALLBACK=
# "true" allows deleting leads. Leave unset in production.
ENABLE_DELETE=
# New leads allowed per rolling hour across the whole app (default 60)
MAX_LEADS_PER_HOUR=
